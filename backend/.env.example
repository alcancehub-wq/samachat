# WhatsApp Provider Configuration
# Supported providers: wwebjs, whaileys
WHATSAPP_PROVIDER=wwebjs

# Logging (silent, fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
WHAILEYS_LOG_LEVEL=error

# Chrome/Puppeteer Configuration
CHROME_BIN=
CHROME_WS=
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox

# Database
DB_HOST=mysql
DB_DIALECT=mysql
DB_PORT=3306
DB_NAME=whaticket
DB_USER=root
DB_PASS=senha

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Backend URL
BACKEND_URL=https://api.DOMINIO.com

# Frontend URL
FRONTEND_URL=https://app.DOMINIO.com

# Proxy
PROXY_PORT=8080

# Redis
REDIS_URL=redis://redis:6379
REDIS_DB=0
# Meta Embedded Signup
# Backend only. Never expose META_EMBEDDED_SIGNUP_APP_SECRET to the frontend.
META_EMBEDDED_SIGNUP_APP_ID=
META_EMBEDDED_SIGNUP_APP_SECRET=
META_EMBEDDED_SIGNUP_API_VERSION=v25.0

# SamaChat CRM M2M; all runtime gates are disabled unless explicitly enabled.
SAMACHAT_CRM_M2M_CAPTURE_ENABLED=false
SAMACHAT_CRM_M2M_DELIVERY_ENABLED=false
SAMACHAT_CRM_M2M_EXECUTOR_ENABLED=false
SAMACHAT_CRM_M2M_INTEGRATION_ID=
SAMACHAT_CRM_M2M_HMAC_SECRET=

# BIA SDR: chave que cifra as credenciais de Gemini/Claude/ElevenLabs no banco
# (AES-256-GCM). 64 caracteres hex. Sem ela o sistema NAO grava chaves.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde fora do banco; se perder, as chaves salvas precisam ser cadastradas de novo.
INTEGRATION_SETTINGS_ENC_KEY=
